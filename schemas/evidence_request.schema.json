{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceRequest",
  "description": "Typed schema for evidence retrieval request",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^SCENARIO-[A-Z0-9]+$",
      "description": "Scenario identifier"
    },
    "evidence_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SOP", "INCIDENT", "POLICY", "OPERATIONAL"]
      },
      "description": "Types of evidence to retrieve"
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Maximum evidence items to retrieve"
    }
  },
  "required": ["scenario_id", "evidence_types"],
  "additionalProperties": false
}