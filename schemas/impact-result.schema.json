{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosdb.dev/schemas/impact-result.schema.json",
  "type": "object",
  "required": [
    "impact_run_id",
    "scenario_id",
    "status",
    "data_quality_status",
    "rule_set_version",
    "input_state_hash",
    "result_hash",
    "affected_purchase_orders",
    "affected_components",
    "inventory_timelines",
    "shortages",
    "affected_production_orders",
    "affected_customer_orders",
    "headline_metrics",
    "causal_traces",
    "warnings",
    "errors",
    "provenance"
  ],
  "properties": {
    "impact_run_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "status": {
      "enum": [
        "PENDING",
        "VALIDATING",
        "RECONSTRUCTING_STATE",
        "APPLYING_DISRUPTION",
        "PROJECTING_INVENTORY",
        "SCHEDULING_PRODUCTION",
        "CALCULATING_CUSTOMER_IMPACT",
        "BUILDING_PROVENANCE",
        "COMPLETED",
        "PARTIALLY_COMPLETED",
        "REJECTED",
        "FAILED"
      ]
    },
    "data_quality_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "PARTIAL_NONCRITICAL",
        "PARTIAL_CRITICAL",
        "INSUFFICIENT",
        "INVALID"
      ]
    },
    "rule_set_version": {"type": "string"},
    "input_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "affected_purchase_orders": {"type": "array", "items": {"type": "object"}},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "inventory_timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "warehouse_id",
          "component_id",
          "opening_time",
          "opening_physical",
          "opening_available",
          "safety_stock",
          "events",
          "minimum_balance",
          "ending_balance",
          "ending_available"
        ],
        "properties": {
          "warehouse_id": {"type": "string"},
          "component_id": {"type": "string"},
          "opening_time": {"type": "string", "format": "date-time"},
          "opening_physical": {"type": "string"},
          "opening_available": {"type": "string"},
          "safety_stock": {"type": "string"},
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "event_time",
                "event_type",
                "warehouse_id",
                "component_id",
                "quantity",
                "delta",
                "source_record_ids"
              ],
              "properties": {
                "event_id": {"type": "string"},
                "event_time": {"type": "string", "format": "date-time"},
                "event_type": {"type": "string"},
                "warehouse_id": {"type": "string"},
                "component_id": {"type": "string"},
                "quantity": {"type": "string"},
                "delta": {"type": "string"},
                "reference_id": {"type": ["string", "null"]},
                "source_record_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "minimum_balance": {"type": "string"},
          "first_safety_stock_breach": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "first_material_shortage": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "ending_balance": {"type": "string"},
          "ending_available": {"type": "string"}
        }
      }
    },
    "shortages": {"type": "array", "items": {"type": "object"}},
    "affected_production_orders": {"type": "array", "items": {"type": "object"}},
    "affected_customer_orders": {"type": "array", "items": {"type": "object"}},
    "headline_metrics": {"type": "object"},
    "causal_traces": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
