{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronosdb.dev/schemas/impact-result.schema.json",
  "type": "object",
  "required": [
    "impact_run_id",
    "scenario_id",
    "status",
    "data_quality_status",
    "rule_set_version",
    "input_state_hash",
    "result_hash",
    "affected_purchase_orders",
    "affected_components",
    "inventory_timelines",
    "shortages",
    "affected_production_orders",
    "affected_customer_orders",
    "headline_metrics",
    "causal_traces",
    "warnings",
    "errors",
    "provenance"
  ],
  "properties": {
    "impact_run_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "status": {
      "enum": [
        "PENDING",
        "VALIDATING",
        "RECONSTRUCTING_STATE",
        "APPLYING_DISRUPTION",
        "PROJECTING_INVENTORY",
        "SCHEDULING_PRODUCTION",
        "CALCULATING_CUSTOMER_IMPACT",
        "BUILDING_PROVENANCE",
        "COMPLETED",
        "PARTIALLY_COMPLETED",
        "REJECTED",
        "FAILED"
      ]
    },
    "data_quality_status": {"enum": ["COMPLETE", "PARTIAL", "INSUFFICIENT"]},
    "rule_set_version": {"type": "string"},
    "input_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "affected_purchase_orders": {"type": "array", "items": {"type": "object"}},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "inventory_timelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "purchase_order_id",
          "warehouse_id",
          "component_id",
          "quantity",
          "event_time",
          "event_type",
          "source",
          "original_event_time",
          "within_horizon",
          "rule_id",
          "source_record_ids"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "purchase_order_id": {"type": "string"},
          "warehouse_id": {"type": "string"},
          "component_id": {"type": "string"},
          "quantity": {"type": "string"},
          "event_time": {"type": "string", "format": "date-time"},
          "event_type": {"type": "string"},
          "source": {"type": "string"},
          "original_event_time": {"type": "string", "format": "date-time"},
          "within_horizon": {"type": "boolean"},
          "rule_id": {"type": "string"},
          "source_record_ids": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "shortages": {"type": "array", "items": {"type": "object"}},
    "affected_production_orders": {"type": "array", "items": {"type": "object"}},
    "affected_customer_orders": {"type": "array", "items": {"type": "object"}},
    "headline_metrics": {"type": "object"},
    "causal_traces": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
