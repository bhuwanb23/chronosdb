{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronosDB Phase 3 serialized record contract",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "ordered_quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "received_quantity": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "INR"
    }
  },
  "additionalProperties": true
}
