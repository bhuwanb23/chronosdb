# ChronosDB local configuration (Phase 15E)
# Copy this file to .env and change every value marked change-me before running.

APP_ENV=development
APP_VERSION=1.0.0
SCHEMA_VERSION=1
LOG_LEVEL=INFO

DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=CHRONOSDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=change-me
DB2_SCHEMA=CHRONOSDB
DB2_CONNECT_TIMEOUT_SECONDS=5

LLM_PROVIDER=LOCAL
EMBEDDING_MODEL=bge-small-en-v1.5
GOLDEN_SCENARIO_ID=SCN-GOLDEN-001

CHRONOSDB_API_KEY=change-me
CHRONOSDB_AUDIT_KEY=change-me
# ChronosDB local configuration template.
# Copy to .env, fill in values, and never commit .env.

# --- Db2 ---------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=CHRONOSDB
DB2_USER=chronosdb
DB2_SCHEMA=CHRONOSDB

# Required. Compose will not start without these.
DB2_PASSWORD=
DB2INST1_PASSWORD=

# --- API credentials ---------------------------------------------------
# Required. Requests must send X-API-Key matching one of these values.
# CHRONOSDB_API_KEY   -> operator: read + write
# CHRONOSDB_AUDIT_KEY -> auditor: read + audit/replay
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHRONOSDB_API_KEY=
CHRONOSDB_AUDIT_KEY=

# Documentation endpoints are published only when this is true AND APP_ENV is
# development. Leave false anywhere else.
CHRONOSDB_DOCS_ENABLED=false

# --- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=LOCAL
EMBEDDING_MODEL=bge-small-en-v1.5

GOLDEN_SCENARIO_ID=SCN-GOLD-001
