# ChronosDB local configuration (Phase 15E)
# Copy this file to .env and change every value marked change-me before running.

APP_ENV=development
APP_VERSION=1.0.0
SCHEMA_VERSION=1
LOG_LEVEL=INFO

DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=CHRONOSDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=change-me
DB2_SCHEMA=CHRONOSDB
DB2_CONNECT_TIMEOUT_SECONDS=5

LLM_PROVIDER=LOCAL
EMBEDDING_MODEL=bge-small-en-v1.5
GOLDEN_SCENARIO_ID=SCN-GOLDEN-001

CHRONOSDB_API_KEY=change-me
CHRONOSDB_AUDIT_KEY=change-me
