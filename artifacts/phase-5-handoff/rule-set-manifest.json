{
  "dataset_compatibility": [
    "1.0.0"
  ],
  "domain_model_version": "phase4-domain-model-1.0.0",
  "rules": [
    {
      "failure_conditions": [
        "missing_effective_interval"
      ],
      "formula": "effective_from <= as_of_time < effective_to",
      "inputs": [
        "effective_from",
        "effective_to",
        "as_of_time"
      ],
      "name": "effective_state_selection",
      "outputs": [
        "eligible_record"
      ],
      "rounding": "none",
      "rule_id": "STATE-001",
      "units": "timestamp",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "invalid_ingested_time"
      ],
      "formula": "ingested_time <= as_of_time",
      "inputs": [
        "ingested_time",
        "as_of_time"
      ],
      "name": "information_time_selection",
      "outputs": [
        "known_record"
      ],
      "rounding": "none",
      "rule_id": "STATE-002",
      "units": "timestamp",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_ordered_quantity",
        "missing_received_quantity"
      ],
      "formula": "max(0, ordered_quantity - received_quantity)",
      "inputs": [
        "ordered_quantity",
        "received_quantity"
      ],
      "name": "outstanding_quantity",
      "outputs": [
        "outstanding_quantity"
      ],
      "rounding": "decimal(3)",
      "rule_id": "SUP-001",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_arrival",
        "invalid_outage_interval"
      ],
      "formula": "max(original_arrival, outage_end + recovery_lag)",
      "inputs": [
        "original_arrival",
        "outage_end",
        "recovery_lag"
      ],
      "name": "disrupted_arrival",
      "outputs": [
        "disrupted_arrival"
      ],
      "rounding": "none",
      "rule_id": "SUP-004",
      "units": "timestamp",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "unknown_supplier",
        "unsupported_scope"
      ],
      "formula": "supplier_matches and outstanding_quantity > 0 and scope_matches",
      "inputs": [
        "supplier_id",
        "outstanding_quantity",
        "scope",
        "expected_arrival"
      ],
      "name": "affected_purchase_order",
      "outputs": [
        "affected_purchase_order"
      ],
      "rounding": "none",
      "rule_id": "SUP-005",
      "units": "boolean",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "negative_outstanding_quantity"
      ],
      "formula": "outstanding_quantity",
      "inputs": [
        "outstanding_quantity"
      ],
      "name": "projected_receipt_quantity",
      "outputs": [
        "projected_receipt_quantity"
      ],
      "rounding": "decimal(3)",
      "rule_id": "SUP-006",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_required_time",
        "missing_allocation"
      ],
      "formula": "max(0, required_quantity - allocated_quantity)",
      "inputs": [
        "required_quantity",
        "allocated_quantity",
        "required_time"
      ],
      "name": "component_shortage",
      "outputs": [
        "shortage_quantity",
        "shortage_type",
        "resolved_time"
      ],
      "rounding": "decimal(3)",
      "rule_id": "INV-003",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_opening_state",
        "negative_balance"
      ],
      "formula": "prior_balance + receipts + transfers_in - consumption - transfers_out",
      "inputs": [
        "opening_available_quantity",
        "receipt_events",
        "consumption_events",
        "transfer_events"
      ],
      "name": "projected_inventory_balance",
      "outputs": [
        "projected_balance"
      ],
      "rounding": "decimal(3)",
      "rule_id": "INV-004",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_requirement",
        "duplicate_allocation"
      ],
      "formula": "min(required_quantity, sum(eligible_source_lots))",
      "inputs": [
        "required_quantity",
        "eligible_source_lots",
        "allocation_priority"
      ],
      "name": "material_allocation",
      "outputs": [
        "allocated_quantity",
        "source_lots",
        "allocation_status"
      ],
      "rounding": "decimal(3)",
      "rule_id": "ALLOC-001",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "capacity_exceeded",
        "material_unavailable"
      ],
      "formula": "max(planned_start, material_ready_time, capacity_ready_time) + processing_duration",
      "inputs": [
        "planned_start",
        "material_ready_time",
        "capacity_ready_time",
        "processing_duration"
      ],
      "name": "projected_production_schedule",
      "outputs": [
        "projected_start",
        "projected_completion",
        "delay_hours"
      ],
      "rounding": "none",
      "rule_id": "PROD-003",
      "units": "timestamp",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_promised_delivery",
        "over_fulfilment"
      ],
      "formula": "on_time = min(open_quantity, available_by_promised); late = max(0, open - on_time)",
      "inputs": [
        "open_quantity",
        "product_availability_events",
        "delivery_lead_time"
      ],
      "name": "customer_fulfilment",
      "outputs": [
        "segments",
        "projected_delivery",
        "on_time_quantity",
        "late_quantity"
      ],
      "rounding": "decimal(3)",
      "rule_id": "FUL-001",
      "units": "quantity",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_promised_delivery"
      ],
      "formula": "breach when projected_delivery > promised_delivery; delay = max(0, projected - promised)",
      "inputs": [
        "projected_delivery",
        "promised_delivery"
      ],
      "name": "sla_classification",
      "outputs": [
        "sla_status",
        "delay_hours"
      ],
      "rounding": "none",
      "rule_id": "SLA-001",
      "units": "hours",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_unit_revenue",
        "negative_quantity"
      ],
      "formula": "late_quantity * unit_revenue",
      "inputs": [
        "late_quantity",
        "unit_revenue"
      ],
      "name": "revenue_at_risk",
      "outputs": [
        "revenue_at_risk",
        "currency"
      ],
      "rounding": "decimal(2)",
      "rule_id": "FIN-004",
      "units": "INR",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_causal_parent",
        "invalid_entity_reference"
      ],
      "formula": "link each breach to its production, material, supply, and disruption ancestors",
      "inputs": [
        "disruption",
        "affected_records",
        "production_impact",
        "sla_impact"
      ],
      "name": "causal_trace",
      "outputs": [
        "causal_nodes",
        "causal_edges",
        "attribution"
      ],
      "rounding": "none",
      "rule_id": "CAU-001",
      "units": "graph",
      "version": "1.0.0"
    },
    {
      "failure_conditions": [
        "missing_required_record_class"
      ],
      "formula": "complete when all required record classes are present",
      "inputs": [
        "required_record_classes",
        "loaded_record_classes"
      ],
      "name": "state_completeness",
      "outputs": [
        "data_quality_status"
      ],
      "rounding": "none",
      "rule_id": "DQ-001",
      "units": "enum",
      "version": "1.0.0"
    }
  ],
  "version": "impact-rules-v1.0.0"
}
